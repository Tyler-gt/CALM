# Official DeepSeek API example for new experiments; supply your own key.
# Paper deployment: deepseek-v4-flash-ascend. Provider model IDs may differ.
CALM_API_BASE_URL=https://api.deepseek.com
CALM_LLM_MODEL=deepseek-flash
CALM_API_KEY=

# Optional: use distinct keys numbered consecutively from CALM_API_KEY_1 to _4.
# Numbered keys take precedence over CALM_API_KEY; one key is sufficient.
# Shell variables override this file. Only CALM_* settings are read.
