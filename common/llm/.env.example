# OpenAI-compatible chat-completions service. Shell variables override this file.
CALM_API_BASE_URL=https://api.example.com/v1
CALM_LLM_MODEL=deepseek-v4-flash-ascend
CALM_API_KEY=

# Optional: use distinct keys numbered consecutively from CALM_API_KEY_1 to _4.
# Numbered keys take precedence over CALM_API_KEY; one key is sufficient.
# Existing USTC_DEEPSEEK_API_KEY / USTC_DEEPSEEK_API_KEY_1..N remain supported.
